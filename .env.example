# Copy to .env and adjust. All values are optional; the defaults in config.py
# let the app run for local development.

# --- Flask / web server ---
EVIDENCE_DB_SECRET_KEY=dev-insecure-change-me
EVIDENCE_DB_HOST=127.0.0.1
EVIDENCE_DB_PORT=5000
EVIDENCE_DB_DEBUG=false
# "*" or a comma-separated allow-list, e.g. https://app.example.org,https://example.org
EVIDENCE_DB_CORS_ORIGINS=*

# --- SQLite (GenomicsDB + qa_data) ---
# Relative paths are resolved against the evidence-database/ directory.
EVIDENCE_DB_SQLITE_PATH=database.db

# --- ChromaDB vector store (LiteratureDB RAG) ---
EVIDENCE_DB_CHROMA_PATH=chroma_data_20250603
EVIDENCE_DB_CHROMA_COLLECTION=searchable_db_collection_fd
# Must match the model the collection was built with.
EVIDENCE_DB_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=
EVIDENCE_DB_LLM_MODEL=gpt-4o-mini

# --- GenomicsDB upstream (CIViC) ---
EVIDENCE_DB_CIVIC_API_URL=https://civicdb.org/api/graphql

# --- Variantscape data files (relative to evidence-database/) ---
EVIDENCE_DB_VARIANTSCAPE_GRAPH=variantscape/network_graph_weighted.gml
EVIDENCE_DB_VARIANTSCAPE_CONSENSUS=variantscape/final_variant_treatment_consensus.csv
EVIDENCE_DB_VARIANTSCAPE_METADATA_MAPPING=variantscape/metadata_mapping_transposed.csv
EVIDENCE_DB_CANCER_SYNONYMS=static/Network_cancer_synonyms.csv

# --- Variantscape tuning ---
EVIDENCE_DB_TREATMENT_MIN_HIGHLIGHT=300
EVIDENCE_DB_CANCER_MIN_HIGHLIGHT=80
EVIDENCE_DB_TREATMENT_THRESHOLD_PERCENTILE=80
EVIDENCE_DB_CANCER_THRESHOLD_PERCENTILE=80
EVIDENCE_DB_MATCHING_RATIO_THRESH=0.8

# --- Partner logos ---
EVIDENCE_DB_PARTNERS_FILE=partners.json
